{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/frames/:set/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "missing": [
        {
          "type": "cookie",
          "key": "arsh_preview"
        }
      ],
      "destination": "/waitlist",
      "permanent": false
    },
    {
      "source": "/index",
      "missing": [
        {
          "type": "cookie",
          "key": "arsh_preview"
        }
      ],
      "destination": "/waitlist",
      "permanent": false
    },
    {
      "source": "/index.html",
      "missing": [
        {
          "type": "cookie",
          "key": "arsh_preview"
        }
      ],
      "destination": "/waitlist",
      "permanent": false
    },
    {
      "source": "/checkout",
      "missing": [
        {
          "type": "cookie",
          "key": "arsh_preview"
        }
      ],
      "destination": "/waitlist",
      "permanent": false
    },
    {
      "source": "/order",
      "missing": [
        {
          "type": "cookie",
          "key": "arsh_preview"
        }
      ],
      "destination": "/waitlist",
      "permanent": false
    },
    {
      "source": "/team",
      "missing": [
        {
          "type": "cookie",
          "key": "arsh_preview"
        }
      ],
      "destination": "/waitlist",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/p/:code",
      "destination": "/piece.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 4 * * *"
    }
  ]
}
