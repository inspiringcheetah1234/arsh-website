# Copy to .env for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Postgres connection string (Neon / Supabase / any Postgres). Required on Vercel.
DATABASE_URL=

# 32+ random characters. Signs admin sessions and order links. Required on Vercel.
SESSION_SECRET=

# Public URL used inside QR codes and emails, e.g. https://arsh.pk (can also be set in Admin → Settings).
SITE_URL=

# Image uploads on Vercel (Vercel → Storage → Blob creates it). Unset locally = files go to public/uploads/.
BLOB_READ_WRITE_TOKEN=

# Transactional email. Option A: a Google Workspace mailbox over SMTP (free with Workspace, ~2,000 sends/day).
# SMTP_PASS is a Google "app password" for that mailbox (16 characters, no spaces), not its normal password.
SMTP_USER=studio@arsh.ltd
SMTP_PASS=
# Option B: Resend (https://resend.com). SMTP wins when both are set. Neither set = emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM="ARSH BY HZK <orders@yourdomain.com>"

# Owner login. Kept in step with these two variables on every start (local and Vercel), so changing
# ADMIN_PASSWORD (10+ characters) and redeploying IS the password reset.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# While the site is in "Waitlist only" (Admin → Overview → Website status), the owner opens
# https://<site>/api/preview?key=<PREVIEW_KEY> once to see the whole site unlocked. 8+ random characters.
PREVIEW_KEY=

# Protects the daily countdown-reminder cron (/api/cron/reminders). Vercel sends it automatically. Any long random string.
CRON_SECRET=

# One-time wipe of the waitlist: set to any NEW value (e.g. 2026-11-22) and redeploy; runs once per value.
# RESET_WAITLIST=
