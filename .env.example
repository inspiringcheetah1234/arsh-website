# Copy to .env for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Postgres connection string (Neon / Supabase / any Postgres). Required on Vercel.
DATABASE_URL=

# 32+ random characters. Signs admin sessions and order links. Required on Vercel.
SESSION_SECRET=

# Public URL used inside QR codes and emails, e.g. https://arsh.pk (can also be set in Admin → Settings).
SITE_URL=

# Image uploads on Vercel (Vercel → Storage → Blob creates it). Unset locally = files go to public/uploads/.
BLOB_READ_WRITE_TOKEN=

# Transactional email via Resend (https://resend.com). Unset = emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM="ARSH BY HZK <orders@yourdomain.com>"

# Local dev only: first owner account created automatically by `npm run dev`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
